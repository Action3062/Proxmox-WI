# =============================================================================
# Proxmox Web Interface – Beispielkonfiguration
# Kopieren nach `.env` und Werte anpassen. Die `.env` NIEMALS committen!
# =============================================================================

# --- Anwendung ---------------------------------------------------------------
APP_NAME=Proxmox Web Interface
ENVIRONMENT=production
LOG_LEVEL=INFO
# Öffentlicher Port des Reverse Proxy (Standard 80)
HTTP_PORT=80

# --- Sicherheit / Authentifizierung ------------------------------------------
# Zufälligen Schlüssel erzeugen, z. B. mit:  openssl rand -hex 32
SECRET_KEY=bitte-einen-zufaelligen-schluessel-eintragen
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin-Login für das Webinterface.
ADMIN_USERNAME=admin
# Entweder ein Klartext-Passwort (wird beim Start gehasht) ...
ADMIN_PASSWORD=bitte-aendern
# ... ODER (bevorzugt) ein vorab erzeugter bcrypt-Hash. Wenn gesetzt, hat er
# Vorrang vor ADMIN_PASSWORD. Erzeugen z. B. mit:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'meinpw', bcrypt.gensalt()).decode())"
# ADMIN_PASSWORD_HASH=

# --- CORS --------------------------------------------------------------------
# Kommagetrennte Liste erlaubter Frontend-Origins. Hinter dem Reverse Proxy
# ist alles same-origin; für lokale Entwicklung den Vite-Port ergänzen.
CORS_ORIGINS=http://localhost,http://localhost:5173

# --- Proxmox VE API ----------------------------------------------------------
PROXMOX_HOST=https://192.168.1.10:8006
PROXMOX_NODE=pve
# API-Token-ID in der Form benutzer@realm!tokenname
PROXMOX_TOKEN_ID=root@pam!webui
PROXMOX_TOKEN_SECRET=00000000-0000-0000-0000-000000000000
# Selbstsignierte Zertifikate im Heimnetz -> false. Mit gültigem Zertifikat true.
PROXMOX_VERIFY_SSL=false

# --- Proxmox-Standardwerte ---------------------------------------------------
PROXMOX_DEFAULT_STORAGE=local-zfs
PROXMOX_TEMPLATE_STORAGE=local
PROXMOX_DEFAULT_BRIDGE=vmbr0
# Storage für vzdump-Backups (muss Inhaltstyp "backup" unterstützen)
PROXMOX_BACKUP_STORAGE=local

# --- Proxmox SSH (für `pct exec`: Software-Installation & Update-Prüfung) -----
# Ohne expliziten Host wird der Hostname aus PROXMOX_HOST abgeleitet.
# PROXMOX_SSH_HOST=192.168.1.10
PROXMOX_SSH_PORT=22
PROXMOX_SSH_USER=root
# Eine der folgenden Authentifizierungsmethoden setzen:
# PROXMOX_SSH_PASSWORD=
# Privaten Schlüssel als Datei ...
# PROXMOX_SSH_KEY_FILE=/run/secrets/proxmox_ssh_key
# ... oder direkt als Inhalt (mehrzeilig, in Anführungszeichen).
# PROXMOX_SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"
